# Copy to .env (local) and set the same names in Vercel → Project → Settings → Environment Variables.
# Only publishable values belong here. NEVER put a Supabase secret / service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional: public site URL used in confirmation / password-reset email links (defaults to the current origin).
VITE_SITE_URL=https://edupath3h.vercel.app
